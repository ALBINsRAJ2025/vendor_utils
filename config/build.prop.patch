# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================

# To apply these changes:

# Method 1: Using build_prop_adapter.py (recommended)
python3 scripts/build_prop_adapter.py \
    --source hot30/system/build.prop \
    --target note11/system/build.prop \
    --output adapted_system_build.prop \
    --patch build_prop_changes.patch

# Method 2: Manual editing
# 1. Extract build.prop from each partition
# 2. Apply changes shown above
# 3. Copy back into partition before rebuilding

# Method 3: Using sed for batch replacement
# sed -i 's/Infinix-X6815/X6517/g' build.prop
# sed -i 's/HOT 30/NOTE 11/g' build.prop
# sed -i 's/X6815-OP/X6517-OP/g' build.prop

# =============================================================================
# VERIFICATION
# =============================================================================

# After applying changes, verify:
# 1. Device identity correct: adb shell getprop | grep ro.product
# 2. Android version correct: adb shell getprop ro.build.version.release
# 3. Fingerprint valid: adb shell getprop ro.build.fingerprint
# 4. No typos or syntax errors in build.prop

# =============================================================================
# WARNINGS
# =============================================================================

# CRITICAL:
# - DO NOT modify IMEI-related properties
# - DO NOT change ro.hardware or ro.board.platform
